.pio
.vscode
build
# Generated by the IDE/PlatformIO; regenerated on demand, not source.
compile_commands.json
# PlatformIO transpiles each .ino into a sibling .ino.cpp at build time.
src/*.ino.cpp
# Vendor factory images (~16 MB each) — reference restore blobs, not build
# inputs. Untracked to keep the repo lean; recoverable from the vendor release.
lib/LilyGoLib/firmware/*.bin

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# PagerLink golden-vector header, generated from protocol/vectors/ at test build.
test/test_link_frame/link_vectors_gen.h

# iOS companion — generated project, build products, per-user state.
/ios/*.xcodeproj/
/ios/**/xcuserdata/
/ios/**/.build/
/ios/**/DerivedData/
/ios/**/*.xcresult
/ios/Config/Local.xcconfig
