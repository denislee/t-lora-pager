# Lets a normal user send the 1200-baud bootloader request to a running LilyGo board
# when /dev/ttyACM* is unavailable (make upload, tools/pager_upload.py).
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="82d4", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="821b", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="8227", MODE="0666"
